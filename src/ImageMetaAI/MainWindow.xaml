<Window x:Class="ImageMetaAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageMetaAI"
        Height="800"
        Width="1200">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Folder selection -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button Content="Select Folder..."
                    Width="150"
                    Height="30"
                    Click="SelectFolder_Click"/>

            <Button Content="Analyze Image (Temp)"
                    Width="150"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="AnalyzeImage_Click"/>

            <TextBlock x:Name="FolderPathText"
                       Margin="15,6,0,0"
                       VerticalAlignment="Center"
                       Text="No folder selected"/>

        </StackPanel>

        <!-- Image count -->
        <TextBlock Grid.Row="1"
                   x:Name="ImageCountText"
                   Margin="0,0,0,10"
                   Text="No images loaded"/>

        <!-- Ollama Status -->
        <TextBlock Grid.Row="2"
                   x:Name="OllamaStatusText"
                   Margin="0,0,0,10"
                   Text="Checking Ollama..."
                   FontWeight="SemiBold"/>

        <!-- Main content area -->
        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Image list -->
            <ListBox x:Name="ImageList"
                     Grid.Column="0"
                     SelectionChanged="ImageList_SelectionChanged">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Grid Margin="5">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding FileName}"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding Status}"
                                       FontSize="12"
                                       Foreground="Gray"/>

                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <!-- Right content -->
            <Grid Grid.Column="1"
                  Margin="15,0,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Image preview -->
                <Border Grid.Row="0"
                        BorderBrush="Gray"
                        BorderThickness="1">

                    <Image x:Name="ImagePreview"
                           Stretch="Uniform"/>

                </Border>

                <!-- Vision description -->
                <GroupBox Grid.Row="1"
                          Header="Vision Description"
                          Margin="0,10,0,0">

                    <TextBox x:Name="VisionDescriptionText"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="100"
                             MaxHeight="150"
                             Padding="8"/>

                </GroupBox>

                <!-- Metadata title -->
                <GroupBox Grid.Row="2"
                          Header="Title"
                          Margin="0,10,0,0">

                    <TextBox x:Name="TitleText"
                             TextWrapping="Wrap"
                             MinHeight="45"
                             Padding="8"/>

                </GroupBox>

                <!-- Metadata keywords -->
                <GroupBox Grid.Row="3"
                          Header="Keywords"
                          Margin="0,10,0,0">

                    <TextBox x:Name="KeywordsText"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="80"
                             MaxHeight="150"
                             Padding="8"/>

                </GroupBox>

            </Grid>

        </Grid>

    </Grid>

</Window>
