<Window x:Class="ImageMetaAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageMetaAI"
        Height="900"
        Width="1200"
        MinHeight="700"
        MinWidth="950">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Folder selection and processing -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Select Folder..."
                    Width="130"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="SelectFolder_Click"/>

            <Button Content="Analyze All New"
                    Width="140"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="AnalyzeAllNew_Click"/>

            <Button Content="Analyze Selected"
                    Width="150"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="AnalyzeSelected_Click"/>

            <TextBlock x:Name="FolderPathText"
                    Margin="8,8,0,0"
                    VerticalAlignment="Center"
                    Text="No folder selected"/>
        </WrapPanel>

        <!-- Image count -->
        <TextBlock Grid.Row="1"
                   x:Name="ImageCountText"
                   Margin="0,0,0,8"
                   Text="No images loaded"/>

        <!-- Status and progress -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="OllamaStatusText"
                       Text="Checking Ollama..."
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <ProgressBar x:Name="ProcessingProgressBar"
                         Height="12"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>

            <TextBlock x:Name="ProcessingProgressText"
                       Text=""
                       FontSize="12"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Image list -->
            <ListBox x:Name="ImageList"
                     Grid.Column="0"
                     SelectionMode="Extended"
                     SelectionChanged="ImageList_SelectionChanged">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding FileName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding Status}"
                                       FontSize="12"
                                       Foreground="Gray"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Selected image details -->
            <ScrollViewer Grid.Column="1"
                          Margin="15,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>
                    <!-- Image preview -->
                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            Height="260">

                        <Image x:Name="ImagePreview"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Vision description -->
                    <GroupBox Header="Vision Description"
                              Margin="0,10,0,0">
                        <TextBox x:Name="VisionDescriptionText"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="80"
                                 MaxHeight="140"
                                 Padding="8"/>
                    </GroupBox>

                    <!-- Additional information -->
                    <GroupBox Header="Additional Information"
                              Margin="0,10,0,0">
                        <TextBox x:Name="AdditionalInformationText"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="65"
                                 MaxHeight="120"
                                 Padding="8"
                                 TextChanged="AdditionalInformationText_TextChanged"
                                 ToolTip="Optional context or details to guide metadata generation."/>
                    </GroupBox>

                    <!-- Metadata title -->
                    <GroupBox Header="Title"
                              Margin="0,10,0,0">
                        <TextBox x:Name="TitleText"
                                 TextWrapping="Wrap"
                                 MinHeight="45"
                                 Padding="8"/>
                    </GroupBox>

                    <!-- Metadata keywords -->
                    <GroupBox Header="Keywords"
                              Margin="0,10,0,0">
                        <TextBox x:Name="KeywordsText"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="80"
                                 MaxHeight="150"
                                 Padding="8"/>
                    </GroupBox>

                    <!-- Primary category -->
                    <GroupBox Header="Primary Category"
                              Margin="0,10,0,0">
                        <ComboBox x:Name="PrimaryCategoryComboBox"
                                  MinHeight="35"
                                  SelectionChanged="PrimaryCategoryComboBox_SelectionChanged"/>
                    </GroupBox>

                    <!-- Secondary category -->
                    <GroupBox Header="Secondary Category"
                              Margin="0,10,0,10">
                        <ComboBox x:Name="SecondaryCategoryComboBox"
                                  MinHeight="35"
                                  SelectionChanged="SecondaryCategoryComboBox_SelectionChanged"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
