<Window x:Class="ImageMetaAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageMetaAI"
        Height="900"
        Width="1200"
        MinHeight="700"
        MinWidth="950">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main actions -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="SelectFolderButton"
                    Content="Select Folder..."
                    Width="130" Height="34"
                    Margin="0,0,8,0"
                    Click="SelectFolder_Click"/>

            <Button x:Name="AnalyzeAllButton"
                    Content="Analyze All"
                    Width="140" Height="34"
                    Margin="0,0,8,0"
                    Click="AnalyzeAll_Click"/>

            <Button x:Name="AnalyzeSelectedButton"
                    Content="Analyze Selected"
                    Width="150" Height="34"
                    Margin="0,0,8,0"
                    Click="AnalyzeSelected_Click"/>

            <Button x:Name="CancelProcessingButton"
                    Content="Cancel Processing"
                    Width="150" Height="34"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="CancelProcessing_Click"/>

            <Button x:Name="ExportCsvButton"
                    Content="Export CSV"
                    Width="190" Height="34"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="ExportCsv_Click"/>
        </WrapPanel>

        <!-- Selected folder -->
        <Border Grid.Row="1"
                Background="#F5F6F7"
                BorderBrush="#D5D9DE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#E7E9EC"
                        CornerRadius="5"
                        Width="44"
                        Height="44"
                        Margin="0,0,12,0">
                    <TextBlock Text="📁"
                               FontSize="23"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="FolderPathText"
                               Text="No folder selected"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="ImageCountText"
                               Text="0 images"
                               FontSize="12"
                               Foreground="Gray"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Open Folder"
                        Width="110" Height="34"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="OpenFolder_Click"/>
            </Grid>
        </Border>

        <!-- Two-phase processing progress -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="OllamaStatusText"
                       Text="Checking Ollama..."
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap"/>

            <TextBlock Text="PHASE 1 · VISION ANALYSIS"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#526579"
                       Margin="0,0,0,4"/>

            <ProgressBar x:Name="VisionProgressBar"
                         Height="12"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>

            <TextBlock x:Name="VisionProgressText"
                       Text="Waiting for processing"
                       FontSize="12"
                       Margin="0,3,0,10"/>

            <TextBlock Text="PHASE 2 · METADATA GENERATION"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#526579"
                       Margin="0,0,0,4"/>

            <ProgressBar x:Name="MetadataProgressBar"
                         Height="12"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>

            <TextBlock x:Name="MetadataProgressText"
                       Text="Waiting for vision analysis"
                       FontSize="12"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Location recognition -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <CheckBox x:Name="RecognizeLocationsCheckBox"
                      Content="Recognize locations from GPS"
                      IsChecked="True"
                      VerticalAlignment="Center"
                      ToolTip="When enabled, GPS coordinates are used to look up a location online. The location can also be used as context for metadata generation."/>
        </StackPanel>

        <!-- Metadata platforms -->
        <Border Grid.Row="4"
                BorderBrush="#D5D9DE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="METADATA PLATFORMS"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="#526579"
                           Margin="0,0,0,8"/>

                <WrapPanel>
                    <CheckBox x:Name="ShutterstockMetadataCheckBox"
                              Content="Shutterstock metadata"
                              IsChecked="True"
                              Margin="0,0,20,6"
                              VerticalAlignment="Center"
                              ToolTip="Generate a Shutterstock-specific title, keywords and categories."/>

                    <CheckBox x:Name="AdobeStockMetadataCheckBox"
                              Content="Adobe Stock metadata"
                              IsChecked="True"
                              Margin="0,0,20,6"
                              VerticalAlignment="Center"
                              ToolTip="Generate an Adobe Stock-specific title, keywords and category."/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Image list and editor -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ImageList"
                     Grid.Column="0"
                     SelectionMode="Extended"
                     SelectionChanged="ImageList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal">
                                <TextBlock Text="{Binding FileName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="🌍"
                                           FontSize="13"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           ToolTip="GPS coordinates available">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasGpsCoordinates}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding DisplayStatus}"
                                       FontSize="12"
                                       Foreground="Gray"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1"
                          Margin="15,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border BorderBrush="#D5D9DE"
                            BorderThickness="1"
                            Height="260">
                        <Image x:Name="ImagePreview"
                               Stretch="Uniform"/>
                    </Border>

                    <GroupBox Header="Vision Description"
                              Margin="0,10,0,0">
                        <StackPanel Margin="8">
                            <TextBlock Text="AI-generated description of the image."
                                       Foreground="Gray"
                                       FontSize="12"
                                       Margin="0,0,0,6"/>

                            <TextBox x:Name="VisionDescriptionText"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="80"
                                     MaxHeight="140"
                                     Padding="8"
                                     Background="#F5F6F7"
                                     BorderBrush="#D5D9DE"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Location"
                              Margin="0,10,0,0">
                        <StackPanel Margin="8">
                            <TextBlock Text="Enter or correct the location for this image."
                                       Foreground="Gray"
                                       FontSize="12"
                                       Margin="0,0,0,6"/>

                            <TextBox x:Name="LocationText"
                                     TextChanged="LocationText_TextChanged"
                                     TextWrapping="Wrap"
                                     MinHeight="38"
                                     MaxHeight="70"
                                     Padding="8"
                                     ToolTip="A manually entered location takes precedence over automatic lookup. Clear the field to allow GPS lookup during analysis."/>

                            <TextBlock x:Name="LocationStatusText"
                                       Text="Location has not been resolved yet."
                                       Foreground="Gray"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Additional Information"
                              Margin="0,10,0,0">
                        <StackPanel Margin="8">
                            <TextBlock Text="Optional context for the AI, such as subject details, setting, purpose or relevant background."
                                       Foreground="Gray"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>

                            <TextBox x:Name="AdditionalInformationText"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="65"
                                     MaxHeight="120"
                                     Padding="8"
                                     TextChanged="AdditionalInformationText_TextChanged"
                                     ToolTip="This information is used as context when generating metadata. It does not replace the image analysis."/>
                        </StackPanel>
                    </GroupBox>

                    <TextBlock Text="EDIT METADATA"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="#526579"
                               Margin="0,14,0,4"/>

                    <TextBlock Text="Review and edit the generated fields before exporting."
                               FontSize="12"
                               Foreground="Gray"
                               Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Shutterstock -->
                        <GroupBox Grid.Column="0"
                                  Header="Shutterstock"
                                  Margin="0,0,6,0">
                            <StackPanel Margin="8">
                                <TextBlock Text="Title"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>

                                <TextBlock Text="A concise, accurate description of the image."
                                           FontSize="11"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="ShutterstockTitleText"
                                         TextWrapping="Wrap"
                                         MinHeight="55"
                                         Padding="6"
                                         TextChanged="ShutterstockTitleText_TextChanged"
                                         ToolTip="Describe the main subject and relevant context clearly and accurately."/>

                                <TextBlock Text="Keywords"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,4"/>

                                <TextBlock Text="Relevant search terms, separated by commas."
                                           FontSize="11"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="ShutterstockKeywordsText"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="100"
                                         Padding="6"
                                         TextChanged="ShutterstockKeywordsText_TextChanged"
                                         ToolTip="Use accurate, relevant keywords. Check spelling and remove duplicates or unrelated terms."/>

                                <TextBlock Text="Primary Category"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,4"/>

                                <TextBlock Text="Choose the category that best describes the image."
                                           FontSize="11"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="ShutterstockPrimaryCategoryComboBox"
                                          MinHeight="32"
                                          SelectionChanged="ShutterstockPrimaryCategoryComboBox_SelectionChanged"/>

                                <TextBlock Text="Secondary Category"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,4"/>

                                <TextBlock Text="Select another relevant category if appropriate."
                                           FontSize="11"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="ShutterstockSecondaryCategoryComboBox"
                                          MinHeight="32"
                                          SelectionChanged="ShutterstockSecondaryCategoryComboBox_SelectionChanged"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Adobe Stock -->
                        <GroupBox Grid.Column="1"
                                  Header="Adobe Stock"
                                  Margin="6,0,0,0">
                            <StackPanel Margin="8">
                                <TextBlock Text="Title"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>

                                <TextBlock Text="A clear and accurate description of the image."
                                           FontSize="11"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="AdobeStockTitleText"
                                         TextWrapping="Wrap"
                                         MinHeight="55"
                                         Padding="6"
                                         TextChanged="AdobeStockTitleText_TextChanged"
                                         ToolTip="Describe the main subject without adding details that are not visible or provided."/>

                                <TextBlock Text="Keywords"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,4"/>

                                <TextBlock Text="Relevant search terms, separated by commas."
                                           FontSize="11"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="AdobeStockKeywordsText"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="100"
                                         Padding="6"
                                         TextChanged="AdobeStockKeywordsText_TextChanged"
                                         ToolTip="Review keyword relevance and ordering before submitting to Adobe Stock."/>

                                <TextBlock Text="Category"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,4"/>

                                <TextBlock Text="Choose the most suitable category for the image."
                                           FontSize="11"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="AdobeStockCategoryComboBox"
                                          MinHeight="32"
                                          SelectionChanged="AdobeStockCategoryComboBox_SelectionChanged"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
